<?xml version="1.0" encoding="utf-8"?>
<!-- Android 图标按钮背景资源。定义矢量图形或按状态变化的背景，供布局、菜单及代码通过 R.drawable 引用。 -->

<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/navigation_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_alt" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</ripple>

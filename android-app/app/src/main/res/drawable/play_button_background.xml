<?xml version="1.0" encoding="utf-8"?>
<!-- Android 播放按钮背景资源。定义矢量图形或按状态变化的背景，供布局、菜单及代码通过 R.drawable 引用。 -->

<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40FFFFFF">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="@color/accent"
                android:endColor="@color/accent_glow"
                android:type="linear" />
        </shape>
    </item>
</ripple>
